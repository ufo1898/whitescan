<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.whitescan.scan</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>whitescan.py</string>
        <string>scan</string>
        <string>--limit</string>
        <string>10</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/liuxin/whitescan</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>10</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>scan.log</string>
    <key>StandardErrorPath</key>
    <string>scan.err</string>
</dict>
</plist>
